# Copy to .env.local for local development. On Vercel, set these as project environment variables.

# --- GitHub sign-in (dashboard, comments, star/fork/edit/delete) -------------------------------
# Create an OAuth app at https://github.com/settings/developers with the callback URL
#   <viewer origin>/api/auth/callback      e.g. http://localhost:3000/api/auth/callback
# Viewing artifacts works without these. They also raise the GitHub API rate limit for the
# metadata the framed view shows (history, file list, comment count).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie. Required in production: `openssl rand -hex 32`.
SESSION_SECRET=

# --- Optional -----------------------------------------------------------------------------------
# Alternative to the OAuth app for public API reads: any GitHub token (no scopes needed).
# GITHUB_TOKEN=

# Serve every artifact from its own origin, <gist-id>.<root domain>. Needs a wildcard DNS record
# and certificate for *.<root domain>. Unset: artifacts are served from /a/<gist-id>/ in a sandbox.
# For local development use: ARTIFACTS_ROOT_DOMAIN=localhost:3000
# ARTIFACTS_ROOT_DOMAIN=viewer.example

# Shown on the landing page and in the sidebar.
# NEXT_PUBLIC_REPO_SLUG=owner/repo
# NEXT_PUBLIC_DEMO_GIST_ID=
